<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <springProfile name="dev">
        <root level="DEBUG">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.github.josiasdev.RelatorioAniversariantes" level="DEBUG"/>
    </springProfile>

    <springProfile name="default | !dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="io.github.bonigarcia" level="WARN"/>
        <logger name="org.seleniumhq" level="WARN"/>
        <logger name="org.springdoc" level="WARN"/>
        <logger name="org.apache.hc.client5" level="WARN"/>
    </springProfile>
</configuration>
