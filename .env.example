# Copie este arquivo para .env e preencha com os valores reais.
# O arquivo .env NUNCA deve ser commitado (ja esta listado no .gitignore).
# Como usar: exporte as variáveis no shell ou no ambiente do processo Java.

# --- Sistema Church (credenciais de login) ---
CHURCH_CLIENT_CODE=19700
CHURCH_USERNAME=seu_usuario
CHURCH_PASSWORD=sua_senha

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_KEY=sua_chave_super_secreta_aqui
WHATSAPP_BASE_URL=http://localhost:8081
WHATSAPP_INSTANCE=igreja
# Numero do destinatario: codigo do pais + DDD + numero (ex.: 5585999999999)
WHATSAPP_DESTINATARIO=5585999999999
